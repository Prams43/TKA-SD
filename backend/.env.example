# Port server Express
PORT=5000

# Konfigurasi Cloudflare D1 REST API
CF_ACCOUNT_ID=your_cloudflare_account_id_here
CF_DATABASE_ID=your_cloudflare_d1_database_uuid_here
CF_API_TOKEN=your_cloudflare_api_token_here

# Rahasia JWT
JWT_SECRET=rahasia_super_aman_tka_sd_2026

# URL Frontend untuk CORS
FRONTEND_URL=http://localhost:5173

# ==============================================================================
# KONFIGURASI LAYANAN PENGIRIMAN EMAIL (PILIH SALAH SATU)
# ==============================================================================
# Opsi 1: Brevo REST API (Sangat Direkomendasikan: Gratis 300 email/hari ke SEMUA alamat email tanpa verifikasi domain)
# Dapatkan gratis di https://app.brevo.com/settings/keys/api
# BREVO_API_KEY=xkeysib-...
# BREVO_FROM_EMAIL=your_email@gmail.com

# Opsi 2: Resend API (Gratis 100 email/hari)
# Catatan: Akun gratis Resend (tanpa custom domain) hanya bisa mengirim ke email yang didaftarkan di Resend.
# RESEND_API_KEY=re_...
# RESEND_FROM="Portal TKA SD <onboarding@resend.dev>"

# Opsi 3: Gmail SMTP (Google App Password)
# Catatan: Provider internet (ISP) di Indonesia sering mereset koneksi SMTP port 465/587 (read ECONNRESET).
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password

